<!doctype html>
<html lang="ko">
 <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>1차 세계대전 퀴즈</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Playfair+Display:wght@700;900&family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js"></script>
  <style>
    :root {
      --vh: 1vh;
    }
    body {
      font-family: 'Noto Sans KR', 'DM Sans', sans-serif;
      background-color: #0f172a; /* Slate 900 */
    }
    .heading-font {
      font-family: 'Playfair Display', 'Noto Sans KR', serif;
    }
    @keyframes heartFloat {
      0% { transform: translateY(0) scale(1); opacity: 1; }
      100% { transform: translateY(-200px) scale(0.5); opacity: 0; }
    }
    .heart-particle {
      position: fixed;
      animation: heartFloat 2s ease-out forwards;
      pointer-events: none;
      font-size: 2rem;
      z-index: 9999;
    }
    .card-grid-item {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .card-grid-item:hover:not(.solved) {
      transform: translateY(-4px) scale(1.05);
      box-shadow: 0 12px 20px rgba(245, 158, 11, 0.2); /* Amber shadow */
      border-color: #f59e0b;
    }
    /* 재도전 모드 시 선택 가능한 오답 카드 디자인 효과 */
    .card-grid-item.retry-target {
      animation: pulse 1.5s infinite;
      cursor: pointer;
    }
    @keyframes pulse {
      0%, 100% { border-color: #ef4444; box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4); }
      50% { border-color: #f87171; box-shadow: 0 0 12px 6px rgba(239, 68, 68, 0.2); }
    }
    .card-grid-item.correct {
      background: linear-gradient(135deg, #065f46, #047857) !important;
      border-color: #34d399 !important;
      color: #a7f3d0 !important;
    }
    .card-grid-item.wrong {
      background: linear-gradient(135deg, #7f1d1d, #991b1b) !important;
      border-color: #f87171 !important;
      color: #fca5a5 !important;
    }
    .card-grid-item.solved {
      cursor: default;
    }
  </style>
 </head>
 <body class="text-slate-100 min-h-screen flex flex-col justify-between">

  <!-- Main Container -->
  <main class="flex-grow w-full flex flex-col justify-center items-center">
    
    <!-- 1. Mode Screen (시작 화면) -->
    <div id="mode-screen" class="flex flex-col items-center justify-center gap-6 p-6 w-full max-w-lg mx-auto text-center">
      <div class="w-full max-w-sm aspect-[16/9] bg-slate-800 rounded-2xl flex flex-col items-center justify-center shadow-2xl border border-slate-700/50 p-6 mb-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-20 h-20 text-amber-500 mb-3 animate-pulse">
          <circle cx="12" cy="12" r="10" />
          <path d="M12 2v20M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
        </svg>
        <span class="text-xs tracking-widest text-slate-400 uppercase font-bold">World War I History Quiz</span>
      </div>

      <h1 class="heading-font text-3xl sm:text-4xl font-extrabold text-amber-400 tracking-tight leading-tight">
        1차 세계대전 역사 퀴즈
      </h1>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-md">
        인류 역사상 가장 거대했던 갈등 중 하나인 1차 세계대전에 관련된 20개의 핵심 질문을 풀고 실력을 검증해 보세요.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 mt-6 w-full max-w-md">
        <button class="flex-1 px-8 py-4 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold rounded-xl shadow-lg shadow-amber-500/10 hover:shadow-amber-500/20 active:scale-95 transition-all flex items-center justify-center gap-2" onclick="showScreen('name-screen')">
          <i data-lucide="play" class="w-5 h-5"></i> 학생용 도전하기
        </button> 
        <button class="flex-1 px-8 py-4 bg-slate-800 hover:bg-slate-700 text-amber-400 font-bold rounded-xl shadow-lg border border-slate-700 hover:border-amber-500/50 active:scale-95 transition-all flex items-center justify-center gap-2" onclick="openPasswordModal()">
          <i data-lucide="shield-alert" class="w-5 h-5"></i> 교사용 결과판
        </button>
      </div>
    </div>

    <!-- 2. Name Screen (정보 입력 화면) -->
    <div id="name-screen" class="hidden flex flex-col items-center justify-center gap-6 p-6 w-full max-w-md mx-auto">
      <div class="text-center">
        <h2 class="heading-font text-2xl sm:text-3xl font-bold text-amber-400 mb-2">도전자 정보 등록</h2>
        <p class="text-xs sm:text-sm text-slate-400">퀴즈 결과 분석 및 순위판 등재를 위해 정보를 입력해 주세요.</p>
      </div>

      <form id="name-form" class="flex flex-col gap-5 w-full bg-slate-800/80 p-6 rounded-2xl border border-slate-700 shadow-xl">
        <div class="flex flex-col gap-2">
          <label for="student-name-input" class="text-sm font-semibold text-slate-300 flex items-center gap-1.5">
            <i data-lucide="user" class="w-4 h-4 text-amber-500"></i> 이름 (실명 입력)
          </label> 
          <input id="student-name-input" type="text" placeholder="홍길동" class="w-full px-4 py-3 bg-slate-900 border-2 border-slate-700 focus:border-amber-500 rounded-xl focus:outline-none text-base text-white placeholder-slate-500 transition-all" required> 
        </div>

        <div class="flex flex-col gap-2">
          <label for="student-birthday-input" class="text-sm font-semibold text-slate-300 flex items-center gap-1.5">
            <i data-lucide="calendar" class="w-4 h-4 text-amber-500"></i> 생년월일
          </label> 
          <input id="student-birthday-input" type="date" class="w-full px-4 py-3 bg-slate-900 border-2 border-slate-700 focus:border-amber-500 rounded-xl focus:outline-none text-base text-white transition-all" required> 
        </div>

        <div class="flex gap-3 mt-2">
          <button type="button" class="flex-1 py-3 px-4 bg-slate-700 hover:bg-slate-600 text-slate-200 font-bold rounded-xl transition-all" onclick="showScreen('mode-screen')">
            이전으로
          </button>
          <button type="submit" class="flex-2 py-3 px-6 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold rounded-xl shadow-lg shadow-amber-500/10 hover:scale-[1.02] active:scale-95 transition-all">
            퀴즈 시작하기
          </button>
        </div>
      </form>
    </div>

    <!-- 3. Quiz Screen (퀴즈 그리드 화면) -->
    <div id="quiz-screen" class="hidden flex flex-col items-center p-4 w-full max-w-4xl mx-auto">
      <div class="w-full bg-slate-800/50 rounded-2xl p-4 sm:p-6 border border-slate-700/50 shadow-2xl">
        <div class="flex flex-wrap justify-between items-center gap-4 mb-6 pb-4 border-b border-slate-700">
          <div class="flex items-center gap-3">
            <div class="bg-amber-500/10 text-amber-400 p-2 rounded-xl border border-amber-500/20">
              <i data-lucide="clock" class="w-5 h-5"></i>
            </div>
            <div>
              <p class="text-xs text-slate-400">도전자</p>
              <p id="quiz-student-info" class="text-sm font-bold text-slate-200">-</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="text-right">
              <span id="quiz-progress" class="text-xs font-bold text-slate-400 block">0 / 20 완료</span>
              <span id="quiz-score" class="text-sm font-black text-amber-400 block">점수: 0점</span>
            </div>
          </div>
        </div>

        <p id="quiz-guide-text" class="text-xs sm:text-sm text-amber-400/80 mb-4 font-semibold flex items-center gap-1">
          <i data-lucide="info" class="w-4 h-4"></i> 질문을 선택하여 퀴즈 카드를 뒤집어 보세요.
        </p>

        <!-- 퀴즈 카드 그리드 -->
        <div id="card-grid" class="grid grid-cols-4 sm:grid-cols-5 gap-3 sm:gap-4"></div>
      </div>
    </div>

    <!-- 4. Question Modal (문제 선택 팝업) -->
    <div id="question-modal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center z-50 p-4">
      <div class="bg-slate-800 rounded-2xl p-6 max-w-lg w-full border border-slate-700 shadow-2xl transform transition-all">
        <div class="flex justify-between items-center mb-4">
          <p id="modal-qnum" class="text-amber-400 text-sm font-extrabold tracking-wider uppercase bg-amber-400/10 px-3 py-1 rounded-full border border-amber-400/20"></p>
          <button class="text-slate-400 hover:text-white" onclick="closeModal()"><i data-lucide="x" class="w-5 h-5"></i></button>
        </div>
        <p id="modal-question" class="text-white text-lg sm:text-xl font-bold mb-6 leading-relaxed"></p>
        <div id="modal-choices" class="grid grid-cols-1 gap-3"></div>
      </div>
    </div>

    <!-- 5. Joker Overlay (단 1문제 오답 재도전 기회 알림) -->
    <div id="joker-overlay" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center z-50 p-4">
      <div class="bg-slate-800 rounded-2xl p-8 max-w-md w-full text-center border border-slate-700 shadow-2xl">
        <div class="w-20 h-20 bg-blue-500/10 text-blue-400 rounded-full flex items-center justify-center mx-auto mb-4 border border-blue-500/20">
          <i data-lucide="refresh-cw" class="w-10 h-10 animate-spin"></i>
        </div>
        <p id="joker-message" class="text-xl font-extrabold text-white mb-2">기회가 남았습니다!</p>
        <p class="text-slate-300 text-sm mb-6">오답이 발생했습니다. 틀린 문제들 중 **단 1개만 골라서 다시 기회**를 얻을 수 있습니다. 신중하게 복구해 보세요!</p>
        <div class="flex gap-3 justify-center">
          <button class="flex-1 py-3 bg-slate-700 hover:bg-slate-600 text-white rounded-xl font-bold transition-all" onclick="dismissJoker()">
            포기하고 완료
          </button> 
          <button class="flex-1 py-3 bg-blue-600 hover:bg-blue-500 text-white rounded-xl font-bold shadow-lg shadow-blue-500/20 transition-all" onclick="confirmJokerRetry()">
            재도전 시작
          </button>
        </div>
      </div>
    </div>

    <!-- 6. Result Screen (결과 화면) -->
    <div id="result-screen" class="hidden flex flex-col items-center justify-center gap-6 p-6 w-full max-w-2xl mx-auto">
      <div class="text-center">
        <h2 id="result-title" class="heading-font text-4xl font-black text-amber-400 mb-2"></h2>
        <p id="result-score" class="text-2xl font-extrabold text-white"></p>
        <p id="result-detail" class="text-slate-300 text-sm sm:text-base max-w-md mx-auto mt-2 leading-relaxed"></p>
      </div>

      <div class="flex gap-4 w-full max-w-md">
        <button class="flex-1 py-4 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold rounded-xl border border-slate-700 transition-all flex items-center justify-center gap-2" onclick="showScreen('mode-screen')">
          <i data-lucide="home" class="w-5 h-5"></i> 메인으로
        </button>
      </div>

      <!-- 오답 해설 아코디언 컨테이너 -->
      <div id="explanation-container" class="hidden w-full bg-slate-800/40 p-4 sm:p-6 rounded-2xl border border-slate-700/50 mt-4 max-h-[400px] overflow-y-auto"></div>
    </div>

    <!-- 7. Teacher Dashboard Password Modal (교사용 비밀번호 팝업) -->
    <div id="password-modal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center z-50 p-4">
      <div class="bg-slate-800 rounded-2xl p-6 max-w-md w-full border border-slate-700 shadow-2xl">
        <div class="flex justify-between items-center mb-4 pb-2 border-b border-slate-700">
          <h3 class="text-white font-bold text-lg flex items-center gap-2">
            <i data-lucide="lock" class="text-amber-500 w-5 h-5"></i> 관리자 권한 확인
          </h3>
          <button class="text-slate-400 hover:text-white" onclick="closePasswordModal()"><i data-lucide="x" class="w-5 h-5"></i></button>
        </div>
        <p class="text-slate-300 text-sm mb-4">교사 대시보드에 접속하려면 비밀번호를 입력하세요.</p>
        <form id="password-form" onsubmit="checkTeacherPassword(event)">
          <div class="mb-4">
            <input id="teacher-password-input" type="password" placeholder="비밀번호 입력" class="w-full px-4 py-3 bg-slate-900 border-2 border-slate-700 focus:border-amber-500 rounded-xl focus:outline-none text-white text-base transition-all" required>
            <p id="password-error-msg" class="text-red-400 text-xs mt-2 hidden">비밀번호가 올바르지 않습니다.</p>
          </div>
          <div class="flex gap-3">
            <button type="button" class="flex-1 py-3 bg-slate-700 hover:bg-slate-600 text-white rounded-xl font-bold transition-all" onclick="closePasswordModal()">
              취소
            </button>
            <button type="submit" class="flex-1 py-3 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold rounded-xl transition-all">
              인증하기
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- 8. Teacher Dashboard (교사 관리 화면) -->
    <div id="teacher-screen" class="hidden p-4 sm:p-6 w-full max-w-5xl mx-auto">
      <div class="bg-slate-800/80 p-6 rounded-2xl border border-slate-700 shadow-2xl">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <div class="flex items-center gap-3">
            <div class="bg-amber-500/10 text-amber-400 p-2.5 rounded-xl border border-amber-500/20">
              <i data-lucide="database" class="w-6 h-6"></i>
            </div>
            <div>
              <h2 class="heading-font text-xl sm:text-2xl font-bold text-white">도전자 전체 기록 대시보드</h2>
              <p class="text-xs text-slate-400">학생들의 전체 학습 결과 데이터를 수집하고 검토합니다.</p>
            </div>
          </div>
          <button class="px-5 py-2.5 bg-slate-700 hover:bg-slate-600 text-white rounded-xl font-bold transition-all flex items-center gap-1.5" onclick="showScreen('mode-screen')">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> 나가기
          </button>
        </div>

        <div class="bg-slate-900 rounded-xl border border-slate-700/80 overflow-hidden shadow-inner">
          <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
              <thead class="bg-slate-800 text-slate-300 uppercase text-xs font-bold border-b border-slate-700">
                <tr>
                  <th class="px-5 py-4">이름</th>
                  <th class="px-5 py-4 text-center">생년월일</th>
                  <th class="px-5 py-4 text-center">최종 점수</th>
                  <th class="px-5 py-4 text-center">재도전 찬스 여부</th>
                  <th class="px-5 py-4">최종 오답 문항 번호</th>
                  <th class="px-5 py-4">도전 시각</th>
                </tr>
              </thead>
              <tbody id="teacher-tbody" class="divide-y divide-slate-800">
                <!-- 동적 레코드 데이터 삽입 영역 -->
              </tbody>
            </table>
          </div>
          
          <div id="no-records" class="text-center text-slate-500 py-12 flex flex-col items-center justify-center gap-3">
            <i data-lucide="folder-open" class="w-12 h-12 text-slate-600"></i>
            <span>아직 등록된 도전자 기록이 존재하지 않습니다.</span>
          </div>
        </div>
      </div>
    </div>

  </main>

  <!-- Hearts Particle Overlay -->
  <div id="hearts-container" class="hidden fixed inset-0 pointer-events-none z-50"></div>

  <!-- Footer -->
  <footer class="w-full py-4 text-center text-xs text-slate-500 border-t border-slate-800/50 mt-8">
    <p>© 1차 세계대전 퀴즈 - 역사 학습 프로젝트</p>
  </footer>

  <script>
    // 퀴즈 문제 은행 데이터 정의 (베르됭 전투 강화 및 치머만 전보 도입)
    const questions = [
        { q: "1차 세계대전이 시작된 해는?", choices: ["1912년","1914년","1916년","1918년"], answer: 1, explain: "1914년 6월 28일 사라예보 사건을 계기로 7월 위기가 발생하여 1914년 8월부터 본격적인 전쟁이 시작되었습니다." },
        { q: "1차 세계대전의 직접적 도화선이 된 사건은?", choices: ["러시아 혁명","사라예보 사건","보스턴 차 사건","베르사유 조약"], answer: 1, explain: "1914년 6월 28일 보스니아-헤르체고비나 수도 사라예보에서 오스트리아-헝가리 대공 프란츠 페르디난드가 암살된 사건입니다." },
        { q: "삼국동맹에 포함되지 않는 나라는?", choices: ["독일","오스트리아-헝가리","이탈리아","프랑스"], answer: 3, explain: "삼국동맹은 독일, 오스트리아-헝가리, 이탈리아로 구성되었고, 프랑스는 삼국협상에 속했습니다." },
        { q: "삼국협상에 포함된 나라는?", choices: ["독일","오스만 제국","러시아","불가리아"], answer: 2, explain: "삼국협상은 영국, 프랑스, 러시아로 구성되어 동맹국(독일, 오스트리아-헝가리, 오스만 제국)에 대항했습니다." },
        { q: "1차 세계대전이 끝난 해는?", choices: ["1917년","1918년","1919년","1920년"], answer: 1, explain: "1918년 11월 11일 독일의 항복으로 1차 세계대전이 종료되었고, 1919년 베르사유 조약이 체결되었습니다." },
        { q: "참호전이 주로 벌어진 전선은?", choices: ["동부전선","서부전선","발칸전선","중동전선"], answer: 1, explain: "프랑스와 독일 사이의 서부전선에서 참호전이 벌어져 수백만 명의 사상자가 발생했습니다." },
        { q: "독일의 무제한 잠수함 작전으로 참전한 나라는?", choices: ["일본","미국","중국","브라질"], answer: 1, explain: "독일의 무제한 잠수함 작전으로 미국 선박이 침몰하자, 1917년 4월 미국이 연합국 측으로 참전했습니다." },
        { q: "1차 세계대전 중 사용된 새로운 무기가 아닌 것은?", choices: ["탱크","독가스","핵폭탄","비행기"], answer: 2, explain: "탱크, 독가스, 비행기는 1차 세계대전에서 처음 사용되었지만, 핵폭탄은 2차 세계대전 후에 사용되었습니다." },
        { q: "베르됭 전투가 벌어진 나라는?", choices: ["벨기에","프랑스","독일","영국"], answer: 1, explain: "베르됭 전투는 1916년 프랑스 동부의 베르됭에서 벌어진 1차 대전 최악의 전투로, 약 70만 명의 사상자가 발생했습니다." },
