        { q: "1차 세계대전의 결과로 해체된 제국이 아닌 것은?", choices: ["오스만 제국","러시아 제국","대영제국","오스트리아-헝가리 제국"], answer: 2, explain: "오스만, 러시아, 오스트리아-헝가리 제국은 1차 대전으로 해체되었지만, 대영제국은 전쟁 후에도 존속했습니다." },
        { q: "독일이 멕시코에 미국 공격을 제안하여 미국의 참전을 결정적으로 촉진시킨 비밀 전보 사건은?", choices: ["치머만 전보 사건", "엠스 전보 사건", "텔레그램 스캔들", "발포어 선언"], answer: 0, explain: "1917년 독일 외무장관 치머만이 멕시코에 동맹을 제안한 전보가 영국에 의해 도청되어 공개되면서 미국 내 참전 여론이 폭발적으로 유도되었습니다." },
        { q: "1차 세계대전 당시 독일 황제는?", choices: ["빌헬름 1세","빌헬름 2세","프리드리히 3세","비스마르크"], answer: 1, explain: "빌헬름 2세는 1888년부터 1918년까지 독일 황대로 재임했고, 1918년 전쟁 패배로 네덜란드로 망명했습니다." },
        { q: "미국의 참전 시기는?", choices: ["1914년","1915년","1916년","1917년"], answer: 3, explain: "미국은 1917년 4월에 1차 대전에 참전하여 연합국을 지원했고, 전쟁 결과에 큰 영향을 미쳤습니다." },
        { q: "독일군의 파리 진격을 저지하여 슐리펜 계획을 좌절시키고, 병력 수송을 위해 파리 택시까지 동원한 서부전선의 결정적 전투는?", choices: ["마른 전투", "솜 전투", "베르됭 전투", "탄넨베르크 전투"], answer: 0, explain: "1914년 9월 발생한 제1차 마른 전투는 프랑스-영국 연합군이 독일군의 파리 진격을 격퇴하여 독일의 단기 속전속결 계획인 '슐리펜 계획'을 무산시키고, 서부전선이 장기적인 참호전으로 빠져들게 만든 대표적인 전투입니다." },
        { q: "1차 세계대전의 사상자 수는 약?", choices: ["100만 명","500만 명","1,700만 명","5,000만 명"], answer: 2, explain: "1차 세계대전의 전체 사상자는 약 1,700만 명으로 추정되며, 이는 당시로서는 엄청난 규모의 인명피해였습니다." },
        { q: "전쟁 후 설립된 국제기구는?", choices: ["유엔","국제연맹","NATO","EU"], answer: 1, explain: "1920년 국제연맹이 설립되어 전쟁 재발을 방지하려 했으나, 미국의 미가입 등으로 효과적이지 못했습니다." },
        { q: "1차 세계대전의 주요 원인이 아닌 것은?", choices: ["민족주의","제국주의","공산주의 확산","군국주의"], answer: 2, explain: "민족주의, 제국주의, 군국주의는 1차 대전의 주요 원인이었지만, 공산주의 확산은 전쟁 중 러시아 혁명으로 나타난 결과입니다." }
    ];

    let studentName = "";
    let studentBirthday = "";
    let score = 0;
    let solvedCards = {}; // index -> 'correct' | 'wrong'
    let wrongIndices = [];
    let retryMode = false;
    let hasUsedRetry = false; // 재도전 찬스 사용 여부 기록
    let allRecords = [];
    let quizStartTime = null;

    // 뷰포트 높이 보정 로직
    function setVh() {
      let vh = window.innerHeight * 0.01;
      document.documentElement.style.setProperty('--vh', `${vh}px`);
    }
    window.addEventListener('resize', setVh);
    window.addEventListener('DOMContentLoaded', setVh);

    // 로컬 스토리지에서 기록 로드
    function loadLocalRecords() {
      const stored = localStorage.getItem('ww1_quiz_records');
      if (stored) {
        try {
          allRecords = JSON.parse(stored);
        } catch(e) {
          allRecords = [];
        }
      }
    }

    // 로컬 스토리지에 기록 저장 및 리액션 유도
    function saveLocalRecord(record) {
      allRecords.push(record);
      localStorage.setItem('ww1_quiz_records', JSON.stringify(allRecords));
      renderTeacherTable();
    }

    function showScreen(id) {
        ['mode-screen','name-screen','quiz-screen','result-screen','teacher-screen'].forEach(s => {
            const screen = document.getElementById(s);
            if (s === id) {
              screen.classList.remove('hidden');
              screen.classList.add('flex');
            } else {
              screen.classList.add('hidden');
              screen.classList.remove('flex');
            }
        });
        window.scrollTo(0, 0);
    }

    // 교사용 보안 패널 제어 로직
    function openPasswordModal() {
      const modal = document.getElementById('password-modal');
      document.getElementById('teacher-password-input').value = "";
      document.getElementById('password-error-msg').classList.add('hidden');
      modal.classList.remove('hidden');
      setTimeout(() => document.getElementById('teacher-password-input').focus(), 100);
    }

    function closePasswordModal() {
      document.getElementById('password-modal').classList.add('hidden');
    }

    function checkTeacherPassword(e) {
      e.preventDefault();
      const pwd = document.getElementById('teacher-password-input').value;
      if (pwd === "교사용1234") {
        closePasswordModal();
        showScreen('teacher-screen');
        renderTeacherTable();
      } else {
        const errorMsg = document.getElementById('password-error-msg');
        errorMsg.classList.remove('hidden');
      }
    }

    // 도전자 정보 폼 전송 이벤트 처리
    document.getElementById('name-form').addEventListener('submit', function(e) {
        e.preventDefault();
        studentName = document.getElementById('student-name-input').value.trim();
        studentBirthday = document.getElementById('student-birthday-input').value;
        if (!studentName || !studentBirthday) return;
        startQuiz();
    });

    function startQuiz() {
        score = 0; 
        solvedCards = {}; 
        wrongIndices = []; 
        retryMode = false; 
        hasUsedRetry = false;
        quizStartTime = new Date();
        
        document.getElementById('quiz-guide-text').innerHTML = `<i data-lucide="info" class="w-4 h-4"></i> 질문을 선택하여 퀴즈 카드를 뒤집어 보세요.`;
        document.getElementById('quiz-student-info').textContent = `${studentName} (${studentBirthday})`;
        showScreen('quiz-screen');
        renderGrid();
        lucide.createIcons();
    }

    function renderGrid() {
        const grid = document.getElementById('card-grid');
        grid.innerHTML = '';
        
        const indices = [...Array(20).keys()];
        
        indices.forEach((qIdx) => {
            const card = document.createElement('button');
            card.type = 'button';
            const num = qIdx + 1;
            
            card.className = 'card-grid-item flex flex-col items-center justify-center rounded-2xl font-bold text-white text-lg shadow-md aspect-square border-2 border-slate-700/80';
            
            if (solvedCards[qIdx] === 'correct') {
                card.classList.add('correct', 'solved');
                card.innerHTML = `
                  <span class="text-xs text-emerald-300 mb-1 font-bold">Q${num}</span>
                  <span class="text-2xl">✓</span>
                `;
            } else if (solvedCards[qIdx] === 'wrong') {
                if (retryMode) {
                    // 재도전 모드 시 오답 카드들을 선택 가능하도록 펄스 애니메이션 부여
                    card.classList.add('wrong', 'retry-target');
                    card.innerHTML = `
                      <span class="text-xs text-red-300 mb-1 font-bold">Q${num}</span>
                      <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-red-500/20 text-red-200">선택</span>
                    `;
                    card.onclick = () => openQuestion(qIdx);
                } else {
                    card.classList.add('wrong', 'solved');
                    card.innerHTML = `
                      <span class="text-xs text-red-300 mb-1 font-bold">Q${num}</span>
                      <span class="text-xl">❌</span>
                    `;
                }
            } else {
                card.style.background = 'linear-gradient(135deg, #1e293b, #334155)';
                card.innerHTML = `
                  <span class="text-xs text-slate-400 mb-1 font-medium">문제</span>
                  <span class="text-xl font-extrabold text-amber-400">${num}</span>
                `;
                // 일반 모드에서는 미해결 카드만 열기 가능
                if (!retryMode) {
                    card.onclick = () => openQuestion(qIdx);
                }
            }
            grid.appendChild(card);
        });
        updateProgress();
    }

    function updateProgress() {
        const solved = Object.keys(solvedCards).length;
        const total = 20;
        document.getElementById('quiz-progress').textContent = `${solved} / ${total} 완료`;
        document.getElementById('quiz-score').textContent = `점수: ${score}점`;
    }

    function openQuestion(qIdx) {
        const q = questions[qIdx];
        document.getElementById('modal-qnum').textContent = `QUESTION ${qIdx + 1}`;
        document.getElementById('modal-question').textContent = q.q;
        
        const container = document.getElementById('modal-choices');
        container.innerHTML = '';
        
        q.choices.forEach((choice, idx) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'w-full py-3.5 px-4 rounded-xl border-2 border-slate-600 hover:border-amber-500 hover:bg-amber-500/10 font-medium text-slate-100 transition-all text-left flex items-center justify-between text-sm sm:text-base';
            btn.innerHTML = `
              <span>${choice}</span>
              <span class="w-5 h-5 rounded-full border border-slate-500 flex items-center justify-center text-xs text-slate-400">${idx+1}</span>
            `;
            btn.onclick = () => handleAnswer(qIdx, idx, btn, container);
            container.appendChild(btn);
        });
        document.getElementById('question-modal').classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('question-modal').classList.add('hidden');
    }

    function handleAnswer(qIdx, chosen, selectedBtn, container) {
        const q = questions[qIdx];
        const buttons = container.querySelectorAll('button');
        buttons.forEach(b => b.disabled = true);

        const isCorrect = (chosen === q.answer);

        if (isCorrect) {
            selectedBtn.className = 'w-full py-3.5 px-4 rounded-xl border-2 border-emerald-500 bg-emerald-950/60 font-semibold text-emerald-300 transition-all text-left flex items-center justify-between text-sm sm:text-base';
            selectedBtn.querySelector('span:last-child').className = 'w-5 h-5 rounded-full bg-emerald-500 flex items-center justify-center text-xs text-slate-950 font-bold';
            selectedBtn.querySelector('span:last-child').textContent = '✓';
            solvedCards[qIdx] = 'correct';
            score++;
            
            // 재도전 찬스 성공 시 오답 목록에서 회수
            if (retryMode) {
              wrongIndices = wrongIndices.filter(idx => idx !== qIdx);
            }
        } else {
            selectedBtn.className = 'w-full py-3.5 px-4 rounded-xl border-2 border-red-500 bg-red-950/60 font-semibold text-red-300 transition-all text-left flex items-center justify-between text-sm sm:text-base';
            selectedBtn.querySelector('span:last-child').className = 'w-5 h-5 rounded-full bg-red-500 flex items-center justify-center text-xs text-white font-bold';
            selectedBtn.querySelector('span:last-child').textContent = '✕';
            
            const correctBtn = buttons[q.answer];
            correctBtn.className = 'w-full py-3.5 px-4 rounded-xl border-2 border-emerald-500 bg-emerald-950/40 font-semibold text-emerald-300 transition-all text-left flex items-center justify-between text-sm sm:text-base';
            
            solvedCards[qIdx] = 'wrong';
            if (!retryMode) {
              wrongIndices.push(qIdx);
            }
        }

        setTimeout(() => {
            closeModal();
            
            if (retryMode) {
              // 단 1개의 문제에 대해서만 재도전 기회를 주므로, 찬스를 수행하면 즉시 완료 화면으로 이동
              retryMode = false;
              hasUsedRetry = true;
              showFinalResult();
            } else {
              renderGrid();
              checkCompletion();
            }
        }, 1500);
    }

    function checkCompletion() {
        const solvedCount = Object.keys(solvedCards).length;
        if (solvedCount >= 20) {
            if (wrongIndices.length > 0) {
                // 아직 1회 찬스를 사용하지 않았다면 알림 모달 출력
                showJokerNotice();
            } else {
                showFinalResult();
            }
        }
    }

    function showJokerNotice() {
      const overlay = document.getElementById('joker-overlay');
      document.getElementById('joker-message').textContent = `오답: ${wrongIndices.length}개 발견`;
      overlay.classList.remove('hidden');
    }

    function dismissJoker() {
      document.getElementById('joker-overlay').classList.add('hidden');
      showFinalResult(); 
    }

    function confirmJokerRetry() {
      document.getElementById('joker-overlay').classList.add('hidden');
      retryMode = true;
      
      // 알림 가이드 갱신
      document.getElementById('quiz-guide-text').innerHTML = `<i data-lucide="info" class="w-4 h-4"></i> <span class="text-red-400 font-extrabold">단 1회의 기회!</span> 아래의 틀린 문제(❌) 카드 중 다시 풀 문항 하나를 직접 터치하세요.`;
      
      renderGrid();
      lucide.createIcons();
    }

    async function showFinalResult() {
        showScreen('result-screen');
        
        const finalWrong = [];
        for (let i = 0; i < 20; i++) { 
          if (solvedCards[i] === 'wrong') finalWrong.push(i); 
        }
        
        let resultTitle = '퀴즈 완료!';
        let resultDetail = finalWrong.length > 0 
          ? `최종 오답: ${finalWrong.map(i=>i+1).join(', ')}번` 
          : '모든 문제를 맞혔습니다! 참된 역사의 마스터이시군요.';

        if (score === 20) {
            resultTitle = '🎉 완벽한 만점! 🎉';
            showHearts();
            if (quizStartTime) {
                const endTime = new Date();
                const timeDiffMs = endTime - quizStartTime;
                const minutes = Math.floor(timeDiffMs / 60000);
                const seconds = Math.floor((timeDiffMs % 60000) / 1000);
                resultDetail = `⏱️ 만점 소요 시간: ${minutes}분 ${seconds}초`;
            }
        }

        document.getElementById('result-title').textContent = resultTitle;
        document.getElementById('result-score').textContent = `최종 결과: ${score} / 20`;
        document.getElementById('result-detail').textContent = resultDetail;

        // 오답 해설 노출 제어
        if (finalWrong.length > 0) {
            showExplanations(finalWrong);
        } else {
            document.getElementById('explanation-container').classList.add('hidden');
        }

        // 기록 개체 저장
        const record = {
            student_name: studentName || '익명 도전자',
            student_birthday: studentBirthday || '미입력',
            score: score,
            total_questions: 20,
            wrong_answers: finalWrong.map(i=>i+1).join(', ') || '없음',
            retry_used: hasUsedRetry ? '1회 사용함' : '미사용',
            completed_at: new Date().toISOString()
        };

        // 로컬 데이터 및 SDK 저장 진행
        saveLocalRecord(record);

        if (window.dataSdk && typeof window.dataSdk.create === 'function') {
          try {
            await window.dataSdk.create(record);
          } catch(e) {
            console.warn("SDK 저장 실패: ", e);
          }
        }
    }

    function showExplanations(wrongIndexes) {
        const container = document.getElementById('explanation-container');
        container.innerHTML = '';
        
        const title = document.createElement('div');
        title.className = 'text-amber-400 font-bold text-lg mb-4 flex items-center gap-2 pb-2 border-b border-slate-700';
        title.innerHTML = '<i data-lucide="book-open" class="w-5 h-5"></i> 📚 최종 오답 분석 노트';
        container.appendChild(title);

        wrongIndexes.forEach(idx => {
            const q = questions[idx];
            const card = document.createElement('div');
            card.className = 'bg-slate-900/60 rounded-xl p-4 mb-3 border border-slate-700/50';
            
            const qText = document.createElement('p');
            qText.className = 'text-amber-300 font-bold mb-2 text-sm sm:text-base';
            qText.textContent = `문제 ${idx+1}: ${q.q}`;
            
            const ansText = document.createElement('p');
            ansText.className = 'text-slate-300 mb-2 text-xs sm:text-sm';
            ansText.innerHTML = `<span class="text-emerald-400 font-semibold">정답:</span> ${q.choices[q.answer]}`;
            
            const expText = document.createElement('p');
            expText.className = 'text-slate-300 text-xs sm:text-sm leading-relaxed border-t border-slate-800 pt-2 mt-2';
            expText.innerHTML = `<span class="text-blue-400 font-semibold">설명:</span> ${q.explain}`;
            
            card.appendChild(qText);
            card.appendChild(ansText);
            card.appendChild(expText);
            container.appendChild(card);
        });

        container.classList.remove('hidden');
        lucide.createIcons();
    }

    // 만점 축하 세레머니 하트 파티클 이펙트
    function showHearts() {
        const container = document.getElementById('hearts-container');
        container.innerHTML = '';
        container.classList.remove('hidden');
        for (let i = 0; i < 30; i++) {
            setTimeout(() => {
                const heart = document.createElement('div');
                heart.className = 'heart-particle'; 
                heart.textContent = '🏅';
                heart.style.left = Math.random() * 100 + '%'; 
                heart.style.top = (60 + Math.random() * 40) + '%';
                container.appendChild(heart);
                setTimeout(() => heart.remove(), 2000);
            }, i * 100);
        }
        setTimeout(() => container.classList.add('hidden'), 4000);
    }

    // 교사용 결과 대시보드 표 렌더링
    function renderTeacherTable() {
        const tbody = document.getElementById('teacher-tbody');
        const noRec = document.getElementById('no-records');
        
        if (allRecords.length === 0) { 
          tbody.innerHTML = ''; 
          noRec.classList.remove('hidden'); 
          return; 
        }
        
        noRec.classList.add('hidden');
        tbody.innerHTML = allRecords.map(r => {
            const formattedDate = r.completed_at ? new Date(r.completed_at).toLocaleString('ko-KR', {
              month: 'short',
              day: 'numeric',
              hour: '2-digit',
              minute: '2-digit'
            }) : '-';

            return `
              <tr class="hover:bg-slate-800/50 transition-colors">
                  <td class="px-5 py-4 font-semibold text-slate-100">${esc(r.student_name)}</td>
                  <td class="px-5 py-4 text-center text-slate-300">${esc(r.student_birthday)}</td>
                  <td class="px-5 py-4 text-center">
                    <span class="px-2.5 py-1 rounded-full text-xs font-black ${r.score === 20 ? 'bg-amber-500/20 text-amber-300' : 'bg-slate-700/50 text-slate-300'}">
                      ${r.score} / 20
                    </span>
                  </td>
                  <td class="px-5 py-4 text-center text-slate-300">
                    <span class="px-2 py-0.5 rounded text-xs ${r.retry_used === '1회 사용함' ? 'bg-blue-500/20 text-blue-300' : 'bg-slate-700/50 text-slate-400'}">
                      ${r.retry_used || '미사용'}
                    </span>
                  </td>
                  <td class="px-5 py-4 text-slate-400 font-mono text-xs max-w-[150px] truncate" title="${r.wrong_answers || '없음'}">${r.wrong_answers || '없음'}</td>
                  <td class="px-5 py-4 text-slate-400 text-xs">${formattedDate}</td>
              </tr>
            `;
        }).join('');
    }

    function esc(s) {
      if (!s) return '';
      const div = document.createElement('div');
      div.textContent = s;
      return div.innerHTML;
    }

    // 초기화 로드 핸들러
    window.onload = function() {
      loadLocalRecords();
      lucide.createIcons();
      
      // data_sdk 연동 안전망 확보
      if (window.dataSdk && typeof window.dataSdk.init === 'function') {
        window.dataSdk.init({
          onDataChanged(data) {
            if (data && Array.isArray(data)) {
              allRecords = data;
              renderTeacherTable();
            }
          }
        });
      }
    };
  </script>
 </body>
</html>
